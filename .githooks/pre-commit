#!/usr/bin/env bash
# =============================================================================
# FixLink Git Pre-Commit Hook
# Validates code formatting (Spotless) before committing.
# =============================================================================

echo "=========================================="
echo " [FixLink Hook] Running pre-commit checks..."
echo "=========================================="

# Auto-detect JAVA_HOME if not set (especially on Windows)
if [ -z "$JAVA_HOME" ]; then
    if [ -d "C:/Program Files/Java/jdk-21.0.10" ]; then
        export JAVA_HOME="C:/Program Files/Java/jdk-21.0.10"
    elif [ -d "C:/Program Files/Java/latest" ]; then
        export JAVA_HOME="C:/Program Files/Java/latest"
    elif [ -n "$JDK_HOME" ]; then
        export JAVA_HOME="$JDK_HOME"
    fi
fi

# Determine project root and backend directory
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
BACKEND_DIR="$PROJECT_ROOT/backend"

if [ ! -d "$BACKEND_DIR" ]; then
    echo "❌ Error: backend directory not found at $BACKEND_DIR"
    exit 1
fi

cd "$BACKEND_DIR" || exit 1

# Check for maven wrapper
if [ -f "./mvnw.cmd" ] && [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    MVN_CMD="./mvnw.cmd"
elif [ -f "./mvnw" ]; then
    MVN_CMD="./mvnw"
else
    MVN_CMD="mvn"
fi

echo "🔍 Checking code formatting with Spotless..."
$MVN_CMD spotless:check -q

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ [Pre-Commit FAILED] Code formatting violations detected!"
    echo "💡 Fix automatically by running:"
    echo "   cd backend && $MVN_CMD spotless:apply"
    echo ""
    exit 1
fi

echo "✅ [Pre-Commit PASSED] Code formatting is clean!"
exit 0
