# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Force LF for source files
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
