# =============================================================================
# FixLink Frontend - Mẫu biến môi trường
# Sao chép tệp này thành .env rồi điền giá trị của dự án Firebase của bạn:
#   cp .env.example .env
#
# Lấy giá trị tại: Firebase Console > Project settings > Your apps > SDK setup
# Thiếu cấu hình thì phần chọn ảnh tự chuyển sang cho dán đường dẫn, ứng dụng
# vẫn chạy bình thường.
#
# Biến VITE_* được nhúng thẳng vào mã nguồn phía trình duyệt, ai cũng đọc được.
# Đây là điều bình thường với Firebase client SDK: quyền ghi phải được siết bằng
# Storage Security Rules, không phải bằng cách giấu apiKey.
# KHÔNG đặt service account key hay bất kỳ bí mật máy chủ nào vào đây.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
