# =============================================================================
# FixLink Environment Configuration Template
# Copy this file to .env before starting the services:
#   cp .env.example .env   (Linux/macOS/Git Bash)
#   copy .env.example .env (Windows CMD/PowerShell)
# =============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=fixlink
POSTGRES_PASSWORD=fixlink_secret_2024
POSTGRES_DB=fixlink_db
POSTGRES_PORT=5432

# Application Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# JWT Authentication
APP_JWT_SECRET=fixlink-jwt-secret-key-2024-must-be-at-least-512-bits-long-for-hs512-algorithm-security
APP_JWT_EXPIRATION_MS=86400000

# FixLink Chatbot Configuration
# Nhà cung cấp LLM: groq (mặc định) hoặc gemini
CHATBOT_PROVIDER=groq
# Lấy key Groq tại https://console.groq.com/keys (dạng gsk_...), dán vào đây, không commit file .env.
GROQ_API_KEY=
# (Tùy chọn) Chuỗi model Groq failover, model đầu tiên là model chính:
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# (Tùy chọn) Dùng Gemini thay Groq: đặt CHATBOT_PROVIDER=gemini và điền GEMINI_API_KEY
# GEMINI_API_KEY=
CHATBOT_ENABLED=true
CHATBOT_TOOLS_MODE=native

# Cloudinary Configuration
CLOUDINARY_URL=cloudinary://733989738725688:rBkMiMu5jzfA0Tp28w_pRZBaxs4@lcnc5sp7
