# =============================================================================
# FixLink Environment Configuration Template
# Copy this file to .env before starting the services:
#   cp .env.example .env   (Linux/macOS/Git Bash)
#   copy .env.example .env (Windows CMD/PowerShell)
# =============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=fixlink
POSTGRES_PASSWORD=fixlink_secret_2024
POSTGRES_DB=fixlink_db
POSTGRES_PORT=5432

# Application Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default

# JWT Authentication
APP_JWT_SECRET=fixlink-jwt-secret-key-2024-must-be-at-least-512-bits-long-for-hs512-algorithm-security
APP_JWT_EXPIRATION_MS=86400000
